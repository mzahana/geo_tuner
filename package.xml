<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>geo_tuner</name>
  <version>0.2.0</version>
  <description>
    Systematic gain design and safe in-flight auto-tuning tools for the
    mav_controllers_ros geometric attitude controller, plus the RViz field
    panels that drive and monitor them.
  </description>
  <maintainer email="mohamedashraf123@gmail.com">Mohamed Abdelkader</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>eigen3_cmake_module</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>eigen</depend>
  <depend>yaml_cpp_vendor</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>mav_controllers_ros</depend>

  <!-- Optional at build time. mavros_msgs supplies the conductor's OFFBOARD
       supervision and the panels' PX4 flight-mode readout; a ground station
       or a distro without mavros still builds and gets everything else. -->
  <build_depend>mavros_msgs</build_depend>
  <exec_depend>mavros_msgs</exec_depend>

  <!-- Optional at build time: the RViz panels are only built where RViz is
       installed, so the vehicle-side build stays free of Qt and OGRE. -->
  <build_depend>rviz_common</build_depend>
  <build_depend>pluginlib</build_depend>
  <build_depend>qt5_gui_libs</build_depend>
  <exec_depend>rviz_common</exec_depend>
  <exec_depend>pluginlib</exec_depend>
  <exec_depend>qt5_gui_libs</exec_depend>

  <!-- The 3D tracking-trail republisher and the offline ulog analyser are
       the only Python left in the package. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <rviz plugin="${prefix}/plugin_description.xml"/>
  </export>
</package>
